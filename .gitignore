# Vendored app build output and deps (rebuilt by Docker, not needed in git)
app-under-test/node_modules/
app-under-test/build/

# Raw .jtl result files: large, and superseded by EVIDENCE_CHECKSUMS.txt + the
# committed HTML dashboards in reports/. Verify any shared .jtl against the
# checksums file rather than trusting it blindly.
results/*.jtl
results/*.log

# Claude Code session-local config, not part of the deliverable
.claude/

# Empty scratch dir JMeter's HTML dashboard generator (-e -o) creates as a side
# effect; harmless, not worth committing
temp/

# JVM heap dumps from OOM crashes during diagnostic/scratch runs (e.g. the
# connection-pool-exhaustion test in TEST_PLAN.md section 6b) -- large, not
# evidence, never intentionally produced
*.hprof
