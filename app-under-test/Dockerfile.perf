# Load-test target build. Not the repo's own Dockerfile (that one installs Sauce
# Connect for cloud e2e runs) -- this is a production-shaped serve: multi-stage
# build to static nginx, not a dev server, so throughput isn't a dev-server artifact.
#
# node:24.9.0-alpine (matches .nvmrc), nginx:1.27-alpine

FROM node:24.9.0-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.perf.conf /etc/nginx/conf.d/default.conf
COPY nginx.perf.main.conf /etc/nginx/nginx.conf
EXPOSE 80
